#!/bin/sh
# pre-commit: 提交前跑五道门
#   1. 分层边界检查（scripts/check_layering.py）—— 依赖方向违规直接阻止提交
#   2. Qt/domain 边界审计（scripts/audit_qt_domain_border.py）—— 确定命中直接阻止提交
#   3. 审计退出码自测（scripts/test_audit_qt_domain_border.py）—— 保证第 2 道门真能拦住
#   4. 其余架构审计 + 各自退出码自测（Qt/analysis 边界 / 命名空间 / 链接可见性）
#      —— 与 CI 的 layering job 清单对齐；这三组在 2026-10-07 之前只在 CI 跑，
#      本地 pre-commit 一路绿、推送后 CI 红
#   5. 暂存的 C++ 文件跑 clang-format（版本需与 CI 钉的 18.1.x 一致）
# 安装: bash scripts/setup-hooks.sh
#
# 为什么第 1 道门必须在本地也跑一遍，不能只靠 CI：
# CMake 拦不住跨层 include —— 每个模块的 include 目录都是仓库根（见 CMakeLists.txt
# 的 videoeye_add_module），#include "core/xxx.h" 一定能编译通过；链接期只对"没声明
# 这条边"的调用报错，而主程序 ui 显式链了全部模块，对 ui 层约束力为零。
# 所以依赖方向唯一真实的检查就是 check_layering.py，让它等到 CI 红就太晚了。

# 没有任何暂存文件（纯 amend 之类）就什么都不做
if [ -z "$(git diff --cached --name-only)" ]; then
    exit 0
fi

PY=""
for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1; then
        PY="$c"
        break
    fi
done

if [ -n "$PY" ]; then
    # 工作区版本，不是暂存版本：check_layering.py 扫的是磁盘上的 #include，
    # 而提交的内容就是工作区内容（有差异时本该先 stash 再提交）。
    if ! "$PY" scripts/check_layering.py; then
        echo "" >&2
        echo "提交已阻止：存在跨层反向依赖。" >&2
        echo "  上面的输出给出了违规的 文件:行 与违反的规则。" >&2
        echo "  规则写在 scripts/check_layering.py 顶部的 RULES；" >&2
        echo "  别往 EXCEPTIONS 里加条目 —— 那里每多一行就等于欠一张「依赖方向没闭合」的条子。" >&2
        exit 1
    fi
else
    echo "warning: 未找到 python，跳过分层检查（CI 仍会跑 scripts/check_layering.py）" >&2
fi

# 第 2 道门: Qt 类型不得从生产侧直接落进 domain 的 std::string 字段。
# 典型形态是 QString 直接赋给 result.error_message —— 编译能过（QString 有隐式
# std::string 转换），但领域模型从此不再是纯 std 结构，domain 也就再没资格说自己零依赖。
# 与 check_layering 的区别: 那条管 #include 方向，这条管字段级污染，查的不是同一件事。
if [ -n "$PY" ]; then
    if ! "$PY" scripts/audit_qt_domain_border.py > /dev/null; then
        echo "" >&2
        echo "提交已阻止：Qt 类型污染 domain std::string 字段（下方为详细输出）" >&2
        echo "  真违规就显式 .toStdString()；确属 Qt 侧自有结构的，把文件加进" >&2
        echo "  scripts/audit_qt_domain_border.py 的 ALLOWED_FILES 并写明原因。" >&2
        echo "  arg_probable（名字撞车的『疑似』项）不拦截，只提示。" >&2
        "$PY" scripts/audit_qt_domain_border.py >&2
        exit 1
    fi
else
    echo "warning: 未找到 python，跳过 Qt/domain 边界审计（CI 仍会跑）" >&2
fi

# 第 3 道门: 审计脚本自己的退出码自测。
# 第 2 道门靠退出码拦人，那"退出码对不对"本身谁在盯？
# 它出过「打印 [命中] 却 return 0」的 bug，人肉读输出看不出问题，
# 所以自测用临时目录造四种场景把退出码钉死。审计逻辑一改就跑这个。
if [ -n "$PY" ]; then
    if ! "$PY" scripts/test_audit_qt_domain_border.py; then
        echo "" >&2
        echo "提交已阻止：审计脚本的退出码语义被改坏了（回归：打印 [命中] 却 return 0）" >&2
        exit 1
    fi
else
    echo "warning: 未找到 python，跳过审计退出码自测（CI 仍会跑）" >&2
fi

# 第 4 道门: 其余架构审计 + 各自退出码自测（与 CI layering job 的清单对齐）。
# 这组脚本与第 1、2 道门是同一个重灾区 —— 「打印了违规却 return 0」出现过不止一次，
# 人肉看输出确认没问题，所以每个审计都要配一个自测把退出码钉死。
# 以前这三组只在 CI 跑：本地提交全绿、推送后 layering job 红，落差归档在 2026-10-07。
if [ -n "$PY" ]; then
    audit_fail=0
    for pair in \
        "audit_qt_analysis_border.py test_audit_qt_analysis_border.py" \
        "audit_namespace_layout.py test_audit_namespace_layout.py" \
        "audit_link_visibility.py test_audit_link_visibility.py"
    do
        set -- $pair
        if ! "$PY" "scripts/$1"; then
            echo "" >&2
            echo "提交已阻止：$1 未通过（详细输出见上）" >&2
            audit_fail=1
        fi
        if ! "$PY" "scripts/$2"; then
            echo "" >&2
            echo "提交已阻止：$2 未通过（审计脚本的退出码语义被改坏了？）" >&2
            audit_fail=1
        fi
    done
    if [ "$audit_fail" -ne 0 ]; then
        exit 1
    fi
else
    echo "warning: 未找到 python，跳过其余架构审计（CI 仍会跑）" >&2
fi

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.cpp' '*.h' '*.hpp' '*.c')
if [ -z "$staged" ]; then
    exit 0
fi

# 第 5 道门找 clang-format 的顺序: $CLANG_FORMAT（显式覆盖） → PATH。
# 不用 `command -v` 一把梭，是因为这台机器上装回来的路径在 PATH 里未必可见
# （见下方安装提示），留一个显式覆盖的口子比让人去改 PATH 便宜。
CF=""
if [ -n "${CLANG_FORMAT:-}" ] && [ -x "${CLANG_FORMAT}" ]; then
    CF="$CLANG_FORMAT"
elif command -v clang-format >/dev/null 2>&1; then
    CF="clang-format"
fi

if [ -z "$CF" ]; then
    echo "warning: 未找到 clang-format，跳过格式检查（CI 的 format job 仍会卡）" >&2
    echo "  本机安装（版本必须与 CI 一致，见 .github/workflows/build.yml 的 format job）:" >&2
    echo "    python -m pip install \"clang-format==18.1.8\"" >&2
    echo "  然后把 site-packages/clang_format/data/bin/ 下的 clang-format(.exe) 放进 PATH，" >&2
    echo "  或设 CLANG_FORMAT=<绝对路径> 指过去。" >&2
    exit 0
fi

# 版本漂移比"没装"更坏: 没装只 warning，装错版本会让本机判绿、CI 判红（或反过来）。
# clang-format 的换行位置/注释对齐/include 排序跨大版本都变，18 与 19 对同一份
# 代码会给出一致性完全不同的结论。漂了只提示不拦截 —— 拦下来只会逼人加 --no-verify。
CF_PINNED="18.1"
cf_ver=$("$CF" --version 2>/dev/null | sed -n 's/.*version \([0-9][0-9.]*\).*/\1/p')
case "$cf_ver" in
    "$CF_PINNED"*) ;;
    "")
        echo "warning: 读不出 clang-format 版本（$CF），跳过版本核对" >&2
        ;;
    *)
        echo "warning: clang-format 版本 $cf_ver ≠ CI 钉的 $CF_PINNED，格式判定可能与 CI 相反" >&2
        echo "  对齐: python -m pip install \"clang-format==18.1.8\"" >&2
        ;;
esac

fail=0
for f in $staged; do
    if ! "$CF" --dry-run --Werror "$f" >/dev/null 2>&1; then
        echo "格式不符合 .clang-format: $f" >&2
        echo "  修复: \"$CF\" -i \"$f\" && git add \"$f\"" >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "提交已阻止：上述文件未通过 clang-format 检查。" >&2
    echo "批量修复: \"$CF\" -i $(echo $staged)" >&2
fi

exit $fail
