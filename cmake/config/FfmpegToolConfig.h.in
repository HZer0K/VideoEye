// 由 CMake 生成，请勿编辑。
//
// 记录「FFmpeg 命令工作台」页的 ffmpeg 可执行程序默认值。
// 用户可在页面设置里覆盖，因此这里的值只是"探测到的最佳猜测"，不是硬约束。
#pragma once

// 配置期探测到的 ffmpeg 可执行程序绝对路径；找不到时为空串。
#define VIDEOEYE_FFMPEG_TOOL_PATH "@VIDEOEYE_FFMPEG_TOOL@"

// ffmpeg 可执行程序的文件名（"ffmpeg.exe" / "ffmpeg"）；找不到时为空串。
// 随包分发时用它拼 "<可执行文件目录>/<name>"。
#define VIDEOEYE_FFMPEG_TOOL_NAME "@VIDEOEYE_FFMPEG_TOOL_NAME@"

// 是否把 ffmpeg 可执行程序复制到了可执行文件旁（Windows 预编译包场景）。
#define VIDEOEYE_FFMPEG_TOOL_BUNDLED @VIDEOEYE_FFMPEG_TOOL_BUNDLED_LITERAL@

// 1 = 上面那个构建期路径优先于 PATH 与常见安装目录（Debug 构建为 1）。
// Release / 安装版为 0: 那时它降级成兜底项，先在用户自己的环境里找，
// 免得安装包隐式依赖一台它不该知道的开发机。
#define VIDEOEYE_FFMPEG_TOOL_PREFER_BUILDTIME @VIDEOEYE_FFMPEG_TOOL_PREFER_BUILDTIME_LITERAL@
