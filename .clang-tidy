---
# clang-tidy 静态检查配置
# 启用 modernize/bugprone/readability/performance 系列，关闭部分噪声较大的检查
Checks: >
  -*,
  bugprone-*,
  modernize-*,
  readability-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-else-after-return,
WarningsAsErrors: ''
HeaderFilterRegex: '^(core|ui|utils)/'
FormatStyle: file
CheckOptions:
  - key:   readability-braces-around-statements.ShortStatementOnSameLine
    value: 'false'
  - key:   modernize-use-default-member-init.UseAssignment
    value: '1'
...
