build-Release/
build-linux/
build-test/
build-ninja/
build-ninja-debug/
build-ninja-test/
cmake-build-*/
out/
.cache/

# IDE / 编辑器
.vs/
.vscode/
.qtcreator/
CMakeUserPresets.json
compile_commands.json
*.swp
*.swo
*~
.DS_Store
