{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "videoeye",
  "version": "2.0.0",
  "description": "VideoEye - 现代化的视频流分析软件",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "brotli", "concurrent", "dbus", "dnslookup",
        "doubleconversion", "freetype", "gui", "harfbuzz",
        "jpeg", "network", "opengl", "openssl", "pcre2", "png",
        "testlib", "thread", "widgets", "zstd"
      ]
    },
    "qtcharts",
    "gtest",
    "sdl2",
    "zlib",
    "vulkan"
  ]
}
