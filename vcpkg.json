{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "videoeye",
  "version": "2.0.0",
  "description": "VideoEye - 现代化的视频流分析软件",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "doubleconversion", "freetype", "gui", "harfbuzz",
        "jpeg", "pcre2", "png", "thread", "widgets"
      ]
    }
  ],
  "features": {
    "tests": {
      "description": "单元测试（GoogleTest）。仅 -DBUILD_TESTING=ON 时需要。",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
