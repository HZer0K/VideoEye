{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "vendor": {
    "videoeye": {
      "note": "本文件是构建配置的唯一真实来源(single source of truth)，不含任何本机绝对路径。build.bat / build.sh 都只是它的薄封装，在脚本里加 -DCMAKE_XXX 就是在绕开本文件。Windows 上需要：环境变量 VCPKG_ROOT 指向 vcpkg 根目录，且 PATH 里能找到 ninja 与 cl.exe（在 'x64 Native Tools Command Prompt for VS 2022' 里执行即可）。要把 VS 版本 / Windows SDK 版本 / cl.exe / ninja 的绝对路径钉死，请写进 CMakeUserPresets.json（已 gitignore），不要修改本文件。",
      "naming-local": "CMakeUserPresets.json 里的本机 preset 统一用**短名**（release / debug / test-release / test-debug），不带 win- 前缀、也不带 -local 后缀。scripts/setup-windows-env.ps1 按这个约定生成；build.bat / build.sh 先试短名、再回退本文件里的 win-* / linux-* 通用名。历史上有过 win-<x>-local 这种第三种拼写，逼得脚本要在三种候选里猜，已废弃。",
      "ide-note": "windows-base 上的 architecture/toolset（strategy=external）是给 IDE 用的：Visual Studio 与 Qt Creator 打开本目录时不会先跑 vcvars，直接调 CMake 会因 PATH 里没有 ninja/cl 而报 'CMAKE_MAKE_PROGRAM is not set' / 'CMAKE_C_COMPILER not set'。带上这两个字段后 VS 会自己注入 MSVC 开发环境（Microsoft 文档里 Ninja preset 的标准写法）。命令行/CI 不受影响。若 IDE 仍以 win-* 通用 preset 报错，请在 IDE 里改选本机 preset（CMakeUserPresets.json 里的 release / debug / test-release / test-debug）。",
      "example-local-overrides": "CMakeUserPresets.json 里 inherits \"win-release\"，再覆盖 environment 与 CMAKE_MAKE_PROGRAM / CMAKE_C_COMPILER / CMAKE_CXX_COMPILER 即可。",
      "naming": "win-* 是 Windows(MSVC+vcpkg)，linux-* 是 Linux/macOS(系统 Qt 与系统 FFmpeg)。*-test-* 额外打开 BUILD_TESTING，并在 Windows 上启用 vcpkg 的 tests feature(gtest)。",
      "vslang-note": "windows-base 里的 CMAKE_{C,CXX}_COMPILER_LAUNCHER=cmake;-E;env;VSLANG=1033 不要删。cl.exe 的 /showIncludes 输出语言跟着 VS 语言资源走（默认中文'注意: 包含文件: '，VSLANG=1033 时英文'Note: including file: '），CMake 在 try_compile 阶段把这句前缀探测进 CMakeFiles/<ver>/CMake{C,CXX}Compiler.cmake，ninja 再拿它剥 /showIncludes 还原头文件依赖。启动器把语言钉成英文，探测值与构建值才不会漂；一旦两者不一致，ninja 剥壳静默失败 -> 改了头文件不重编 -> 链接陈旧对象（Windows 上表现为 0xc0000409 / 0xc0000374 这类看似代码写坏的崩溃）。附带好处是编译日志变纯 ASCII，不再需要 grep -a 读 GB18030。守卫见 scripts/check_msvc_showincludes_prefix.py（ctest: MsvcShowIncludesPrefixTests）。"
    }
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-release",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/scripts/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/scripts/overlay-ports",
        "FFMPEG_ROOT": "${sourceDir}/third_party/prebuilt/windows-x64/ffmpeg",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": "cmake;-E;env;VSLANG=1033",
        "CMAKE_CXX_COMPILER_LAUNCHER": "cmake;-E;env;VSLANG=1033"
      }
    },
    {
      "name": "windows-test-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "win-release",
      "displayName": "Windows Release (Ninja + MSVC)",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-debug",
      "displayName": "Windows Debug (Ninja + MSVC)",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows-debug",
        "VCPKG_HOST_TRIPLET": "x64-windows-release"
      }
    },
    {
      "name": "win-test-release",
      "displayName": "Windows Release + Unit Tests (推荐/CI 用: 复用 release triplet)",
      "inherits": "windows-test-base",
      "binaryDir": "${sourceDir}/build/test-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-test-debug",
      "displayName": "Windows Debug + Unit Tests (首次会用 debug triplet 重编 Qt, 很慢)",
      "inherits": "windows-test-base",
      "binaryDir": "${sourceDir}/build/test-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows-debug",
        "VCPKG_HOST_TRIPLET": "x64-windows-release"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-test-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux/macOS Release",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux/macOS Debug",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-test-debug",
      "displayName": "Linux/macOS Debug + Unit Tests",
      "inherits": "linux-test-base",
      "binaryDir": "${sourceDir}/build/test-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-test-asan",
      "displayName": "Linux/macOS ASan+UBSan + Unit Tests",
      "inherits": "linux-test-base",
      "binaryDir": "${sourceDir}/build/test-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-test-tsan",
      "displayName": "Linux/macOS TSan + Unit Tests",
      "inherits": "linux-test-base",
      "binaryDir": "${sourceDir}/build/test-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux libFuzzer 入口（clang + ASan/UBSan，不产出可发布二进制）",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VIDEOEYE_ENABLE_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-release",
      "configurePreset": "win-release"
    },
    {
      "name": "win-debug",
      "configurePreset": "win-debug"
    },
    {
      "name": "win-test-release",
      "configurePreset": "win-test-release"
    },
    {
      "name": "win-test-debug",
      "configurePreset": "win-test-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-test-debug",
      "configurePreset": "linux-test-debug"
    },
    {
      "name": "linux-test-asan",
      "configurePreset": "linux-test-asan"
    },
    {
      "name": "linux-test-tsan",
      "configurePreset": "linux-test-tsan"
    },
    {
      "name": "linux-fuzz",
      "configurePreset": "linux-fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "win-test-release",
      "configurePreset": "win-test-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "win-test-debug",
      "configurePreset": "win-test-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "linux-test-debug",
      "configurePreset": "linux-test-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "linux-test-asan",
      "configurePreset": "linux-test-asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=0",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=0"
      }
    },
    {
      "name": "linux-test-tsan",
      "configurePreset": "linux-test-tsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "second_deadlock_stack=1:history_size=4"
      }
    }
  ]
}
